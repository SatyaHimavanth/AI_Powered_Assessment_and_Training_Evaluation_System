POSTGRES_USER="assessment_app"
POSTGRES_PASSWORD="replace-with-a-long-random-database-password"
POSTGRES_DB="assessment_db"
APP_ENV=development # Set production when HTTPS is terminated by a trusted proxy
RUN_WORKER_IN_API=true # Local development convenience; Compose disables this for its dedicated worker service
PYTHON_RUNNER_MODE=local # local runs in this backend service; queue uses the optional isolated sandbox
PYTHON_RUNNER_QUEUE_DIR="./.sandbox-jobs" # Used only when PYTHON_RUNNER_MODE=queue
DATABASE_URL="postgresql://assessment_app:replace-with-a-long-random-database-password@db:5432/assessment_db"
DATABASE_URL_ASYNC="postgresql+asyncpg://assessment_app:replace-with-a-long-random-database-password@db:5432/assessment_db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
# Set these in deployment to validate peak connections for both sync and async
# pools across every API replica/process. Reserve room for migrations/workers/admin.
DB_SERVER_MAX_CONNECTIONS=
DB_CONNECTION_RESERVE=10
DB_REPLICA_COUNT=1
DB_WORKER_PROCESSES=1
JWT_SECRET_KEY="replace-with-a-different-32-character-long-random-secret"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# LLMs
CHAT_PROVIDER="azure_openai"
CHAT_DEPLOYMENT_NAME="gpt-4.1"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
OPENAI_API_VERSION=""
EMBEDDING_PROVIDER="azure_openai"
EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"
# pgvector (default) or json (temporary fallback without the vector extension)
EMBEDDING_STORAGE_BACKEND="pgvector"
EMBEDDING_DIM=1536

DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="replace-with-a-unique-admin-password"
DEFAULT_ADMIN_EMAIL="admin@assessment.com"
DEFAULT_ADMIN_CONTACT_EMAIL="admin@assessment.com"
DEFAULT_ADMIN_NAME="System Admin"

DEFAULT_USER_USERNAME="user"
DEFAULT_USER_PASSWORD="replace-with-a-unique-candidate-password"
DEFAULT_USER_EMAIL="user@assessment.com"
DEFAULT_USER_CONTACT_EMAIL="user@assessment.com"
DEFAULT_USER_NAME="Default User"

DEFAULT_BATCH_NAME="Default Batch"

REGISTRATION_EXPIRY_DAYS=2
INTERVIEW_REQUEST_EXPIRY_DAYS=14
PRACTICE_TESTS_MAX_PER_DAY=3
PRACTICE_TESTS_PER_DAY=1
SIMILARITY_THRESHOLD_HIGH_DUP=0.85
SIMILARITY_THRESHOLD_REVIEW=0.70

EMBEDDING_STORAGE_BACKEND=json
SQL_SANDBOX_SCHEMA=demo
SQL_SANDBOX_ALLOWED_TABLES=employees,departments
SQL_SANDBOX_USERNAME=assessment_sql
SQL_SANDBOX_DATABASE_URL="postgresql://assessment_sql:replace-with-read-only-password@db:5432/assessment_db"
SQL_SANDBOX_QUERY_TIMEOUT_MS=3000
