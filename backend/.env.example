JWT_SECRET_KEY="your-secret-key-here"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# LLMs
CHAT_MODEL_NAME="azure_openai:gpt-4.1"
CHAT_DEPLOYMENT_NAME="gpt-4.1"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
OPENAI_API_VERSION=""
EMBEDDING_MODEL_NAME="azure_openai:text-embedding-3-small"
EMBEDDING_DEPLOYMENT_NAME="text-embedding-3-small"
# pgvector (default) or json (temporary fallback without the vector extension)
EMBEDDING_STORAGE_BACKEND="pgvector"
EMBEDDING_DIM=1536

DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="admin123"
DEFAULT_ADMIN_EMAIL="admin@assessment.com"
DEFAULT_ADMIN_CONTACT_EMAIL="admin@assessment.com"
DEFAULT_ADMIN_NAME="System Admin"

DEFAULT_USER_USERNAME="user"
DEFAULT_USER_PASSWORD="user123"
DEFAULT_USER_EMAIL="user@assessment.com"
DEFAULT_USER_CONTACT_EMAIL="user@assessment.com"
DEFAULT_USER_NAME="Default User"

DEFAULT_BATCH_NAME="Default Batch"

REGISTRATION_EXPIRY_DAYS=2
INTERVIEW_REQUEST_EXPIRY_DAYS=14
PRACTICE_TESTS_MAX_PER_DAY=3
PRACTICE_TESTS_PER_DAY=1
SIMILARITY_THRESHOLD_HIGH_DUP=0.85
SIMILARITY_THRESHOLD_REVIEW=0.70

EMBEDDING_STORAGE_BACKEND=json
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/assessment_db"
DATABASE_URL="postgresql://postgres:password@localhost:5432/assessment_db"
SQL_SANDBOX_SCHEMA=demo
SQL_SANDBOX_ALLOWED_TABLES=employees,departments
