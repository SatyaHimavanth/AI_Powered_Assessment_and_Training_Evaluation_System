# Deployed service URLs
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Existing administrator used to provision isolated test data
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin123

# Existing user credentials used by safe authentication API tests
TEST_USER_USERNAME=user
TEST_USER_PASSWORD=user123

# Optional when running pytest markers directly. run_all.py enables both.
RUN_STATEFUL_TESTS=0
RUN_E2E_TESTS=0

# Frontend origin expected in the backend CORS allowlist
CORS_TEST_ORIGIN=http://localhost:5173
